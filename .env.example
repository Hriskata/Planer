# Copy to .env at the repo root. Read by docker-compose (env_file) at `docker compose up` time.

# Same generation approach as backend/.env.example:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

PORT=3000
DB_PATH=/app/backend/data/tasks.db
BACKUP_DIR=/app/backend/backups
UPLOADS_DIR=/app/backend/uploads

# Server timezone — task date/time have no timezone of their own (plain local
# wall-clock strings), so this must match where your users actually are or reminders
# fire at the wrong moment. Default: Europe/Sofia.
TZ=Europe/Sofia

# Cloudflare Tunnel token — see README "Cloudflare Tunnel" section for how to get one.
TUNNEL_TOKEN=

# Web Push (task reminders). Generate once with:
# node -e "console.log(require('web-push').generateVAPIDKeys())" (from backend/, after npm install)
# The frontend fetches VAPID_PUBLIC_KEY from GET /api/push/vapid-public-key at runtime,
# so it only needs to live here, not duplicated into a frontend env var.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# "Email a task on completion" — each user sets their own Gmail address + App Password
# in Settings (not a server-wide SMTP account), so the only thing needed here is the key
# that encrypts those App Passwords at rest. Generate once with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Losing/changing this key makes any already-stored App Passwords undecryptable —
# back it up along with the rest of .env.
ENCRYPTION_KEY=

# Sign in with Google. Create an OAuth 2.0 Client ID (Web application) at
# https://console.cloud.google.com/apis/credentials — add this server's real URL(s) under
# "Authorized JavaScript origins". Only the Client ID is needed (not a client secret —
# the frontend flow only ever exchanges an ID token, not an authorization code). Leave
# empty to disable Google Sign-In entirely (the button just won't appear).
GOOGLE_CLIENT_ID=

# Optional allowlist for NEW accounts created via Google sign-in — comma-separated exact
# emails (e.g. alice@gmail.com,bob@gmail.com). Empty/unset = anyone can register (fine
# for a public landing page; set this once the app should stop accepting strangers —
# existing accounts are never retroactively locked out by tightening this later).
GOOGLE_ALLOWED_EMAILS=
