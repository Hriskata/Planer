# Copy this file to .env and fill in the real values. .env is NOT committed to git.

PORT=3000

# Path to the SQLite file. In Docker this will point to a mounted volume (see Stage 4).
DB_PATH=./data/tasks.db

# Where `npm run backup` writes snapshots (see src/backup.js).
BACKUP_DIR=./backups

# Where uploaded task images are stored (see src/routes/uploads.js).
UPLOADS_DIR=./uploads

# A long random string — e.g. the output of: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Enable CORS only for the dev frontend server (Vite). Empty/unset = disabled (production).
CORS_ORIGIN=http://localhost:5173

# Web Push (task reminders, sent ~10 min before a task's time). Generate once with:
# node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# "Email a task on completion" — each user sets their own Gmail address + App Password
# in Settings (not a server-wide SMTP account), so the only thing needed here is the key
# that encrypts those App Passwords at rest. Generate once with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Losing/changing this key makes any already-stored App Passwords undecryptable —
# back it up along with the rest of .env.
ENCRYPTION_KEY=

# Sign in with Google. Create an OAuth 2.0 Client ID (Web application) at
# https://console.cloud.google.com/apis/credentials — add this server's real URL(s) under
# "Authorized JavaScript origins" (e.g. http://localhost:3000 for local testing, plus
# your actual domain once deployed). Only the Client ID is needed (not a client secret —
# the frontend flow only ever exchanges an ID token, not an authorization code).
GOOGLE_CLIENT_ID=

# Optional allowlist for NEW accounts created via Google sign-in — comma-separated exact
# emails (e.g. alice@gmail.com,bob@gmail.com). Empty/unset = anyone can register (fine
# for a public landing page; set this once the app should stop accepting strangers —
# existing accounts are never retroactively locked out by tightening this later).
GOOGLE_ALLOWED_EMAILS=
